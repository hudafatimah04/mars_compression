{
  "name": "mars-compression-presentation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "dev:watch": "nodemon --watch \"vite.config.{js,mjs,cjs,ts,mts,cts,json}\" --watch \"tailwind.config.{js,mjs,cjs,ts,mts,cts,json}\" --watch \"postcss.config.{js,mjs,cjs,ts,mts,cts,json}\" --watch package.json --ext js,mjs,cjs,ts,mts,cts,json --exec \"npm.cmd run dev\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
